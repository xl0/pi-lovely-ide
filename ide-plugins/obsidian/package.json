{
	"name": "pi-lovely-ide-obsidian",
	"version": "0.1.0",
	"description": "Pi IDE Protocol bridge for Obsidian",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"build": "node esbuild.mjs --production",
		"compile": "bun run typecheck && node esbuild.mjs",
		"check": "bun run typecheck && bun test",
		"test": "bun test",
		"dev": "node esbuild.mjs --watch"
	},
	"dependencies": {
		"valibot": "^1.4.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@codemirror/view": "^6.0.0",
		"@types/bun": "^1.3.0",
		"@types/node": "^20.0.0",
		"@types/ws": "^8.5.0",
		"esbuild": "^0.25.0",
		"obsidian": "^1.7.0",
		"typescript": "^5.5.0"
	}
}
